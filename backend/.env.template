# Needed if using sqlite3, but not if postgres
CGO_ENABLED=1

# Sqlite3 driver (default). datastore/ is where the GCS volume gets mounted
# in production - a manual step in the Cloud Run console (Volumes /
# Volume Mounts), not a scripted gcloud command; see the root Makefile's
# comment above docker_run for the exact steps.
#
# journal_mode is DELETE (SQLite's default), not WAL - WAL needs proper
# byte-range locking and mmap'd shared memory for its -wal/-shm files,
# which Cloud Storage FUSE doesn't provide. Using WAL against the mounted
# datastore/ volume in production fails hard: writes intermittently error
# with "disk I/O error", and the GCS-side log shows the -wal file getting
# "clobbered due to generation/metageneration mismatch". DELETE mode does
# plain whole-file writes, which FUSE handles fine.
RM_DB_DRIVER=sqlite3
RM_DB_CONNECTION=./datastore/rigormining.db
RM_DB_POST=PRAGMA synchronous = normal;PRAGMA journal_mode = DELETE;PRAGMA temp_store = memory

# Postgres driver (alternative)
# RM_DB_DRIVER=postgres
# RM_DB_CONNECTION=host=127.0.0.1 port=5432 user=postgres dbname=postgres password=postgres sslmode=disable

RM_LIBRARY_DIR=./datastore/library

# Where the built frontend (frontend/dist) is served from, and the CORS
# origin allowed during local dev, where the frontend runs on a different
# port than the API (webpack-dev-server).
RM_WEB_STATIC_DIR=../frontend/dist
RM_WEB_ALLOWED_ORIGIN=http://localhost:8080

# OAuth2 settings (Google) - create credentials at
# https://console.cloud.google.com/apis/credentials
RM_AUTH_REDIRECT_URL=http://localhost:3000/callback
RM_AUTH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
RM_AUTH_CLIENT_SECRET=xxxxx-xx-xxxxxxxxxx
RM_AUTH_SCOPES=email openid https://www.googleapis.com/auth/userinfo.email
RM_AUTH_AUTH_URL=https://accounts.google.com/o/oauth2/auth
RM_AUTH_TOKEN_URL=https://oauth2.googleapis.com/token
RM_AUTH_AUTH_STYLE=1
RM_AUTH_ACCESS_TOKEN_URL=https://www.googleapis.com/oauth2/v2/userinfo?access_token=

# Local dev only: logs the browser in as a fixed local user via GET
# /dev-login, no Google OAuth round-trip needed. NEVER set this true in a
# deployed environment.
RM_AUTH_DEV_LOGIN=true
