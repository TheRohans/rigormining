# Deploy-time config (image build/push) - separate from backend/.env and
# frontend/.env, which are app-runtime config for local dev. Copy this to
# .env and fill it in; .env is gitignored.

# Docker Hub repo / image name -> image ends up at
# $(REPOSITORY)/$(PROJECT):<git-hash>, e.g. therohans/rigormining:abc1234
REPOSITORY=
PROJECT=rigormining

# Reference only, not read by the Makefile - the Cloud Run deploy itself is
# manual in the console (see Makefile's docker_push target and the comment
# below it). This is the bucket you mount at /root/datastore there: it
# holds the sqlite db (RM_DB_CONNECTION) and every user's uploaded
# PDFs/EPUBs (RM_LIBRARY_DIR). Must already exist and must NOT be public:
# per-user isolation is enforced by the app (one subfolder per user UUID +
# an ownership check on every file read), not by bucket ACLs.
BUCKET=
