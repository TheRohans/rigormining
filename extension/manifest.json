{
  "manifest_version": 3,
  "name": "Rigor Mining Capture",
  "version": "0.2.1",
  "description": "Capture PDFs and EPUBs from the web into your Rigor Mining library.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rigormining@therohans.com",
      "strict_min_version": "121.0",
      "update_url": "https://rigormining.therohans.com/extension/firefox/updates.json",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  }
}
